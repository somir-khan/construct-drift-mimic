# ============================================================
# Environment variables template
# Copy this file to .env and fill in your values:
#   cp env.example .env
# ============================================================

# ----------------------------------------------------------
# General
# ----------------------------------------------------------
DATA_PATH=data
OPENAI_API_KEY=sk-...
HF_TOKEN=hf_...

# ----------------------------------------------------------
# MIMIC-III multi-table visualization script
# (generate_mimic3_visualizations_multi_table.py)
# ----------------------------------------------------------

# Absolute path to the MIMIC-III SQLite database file
MIMIC_DB_PATH=

# Table names (defaults match standard MIMIC-III uppercase naming)
MIMIC_PATIENTS_TABLE=patients
MIMIC_ADMISSIONS_TABLE=admissions
MIMIC_NOTEEVENTS_TABLE=noteevents

# Output directory for generated PNGs and summary report
MIMIC_OUTPUT_DIR=outputs/visualizations/mimic3


MIMIC3_DB_PATH=
MIMIC4_DB_PATH=
MIMIC4_PATIENTS_TABLE='"hosp/patients"'
AMIMIC4_ADMISSIONS_TABLE='"hosp/admissions"'
MIMIC4_DISCHARGE_TABLE='"note/discharge"'
MIMIC4_OUTPUT_DIR='outputs/visualizations/mimic4'